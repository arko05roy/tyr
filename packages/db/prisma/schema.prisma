// PRD §1.1 core data model.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LimitPeriod {
  day
  week
}

enum Side {
  yes
  no
}

enum Visibility {
  private
  public
}

model User {
  id                  String   @id @default(cuid())
  tempoAddress        String   @unique
  passkeyCredentialId String   @unique
  passkeyPublicKey    String // uncompressed P-256 (0x04‖x‖y); Tempo address derives from it
  passkeyCounter      Int      @default(0)
  region              String?
  createdAt           DateTime @default(now())

  sessions             Session[]
  lossLimits           LossLimit[]
  confidentialAccount  ConfidentialAccount?
  deposits             Deposit[]
  depositAddresses     DepositAddress[]
  orders               Order[]
  agentSessions        AgentSession[]
}

model LossLimit {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  period           LimitPeriod
  amountUsd        Decimal     @db.Decimal(18, 6)
  tempoAccessKeyId String // access key address on Tempo
  accessKeyCipher  String // backend-held P-256 access key, AES-256-GCM (TYR_SECRETS_KEY)
  token            String // TIP-20 the limit applies to
  expiresAt        DateTime
  authorizedTx     String?
  createdAt        DateTime    @default(now())

  @@index([userId])
}

model ConfidentialAccount {
  userId             String @id
  user               User   @relation(fields: [userId], references: [id])
  solanaTokenAccount String @unique
  elgamalPubkey      String
  aeKeyRef           String
}

model Deposit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  sourceChain String
  sourceTx    String
  amount      Decimal  @db.Decimal(36, 18)
  status      String
  solanaTx    String?
  createdAt   DateTime @default(now())

  // Phase 6: funding router. amount = USD credited (tyrUSD). status: confirmed → minted → credited.
  asset       String   @default("USDC") // USDC | ETH | AlphaUSD
  logIndex    Int      @default(-1) // log index of the ERC-20/TIP-20 transfer; -1 for native ETH / Solana
  rawAmount   String? // source-chain base units (wei, 6-dec USDC, …)
  fxRate      Decimal? @db.Decimal(36, 8) // ETH/USD used (Chainlink Sepolia)
  fxRound     String? // Chainlink roundId the rate came from
  mintTx      String? // treasury tyrUSD mint into the user's ATA (public)
  creditedAt  DateTime?

  @@unique([sourceChain, sourceTx, logIndex])
  @@index([userId])
  @@index([status])
}

/// Per-user deposit endpoints (PRD 6.1, 6.3, 6.4). evm: HD-derived EOA (same on every EVM testnet);
/// solana: CT owner address (devnet USDC lands in its classic-SPL ATA); tempo: memo32 for the treasury.
model DepositAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  chain     String // evm | solana | tempo
  address   String
  hdIndex   Int?     @unique
  createdAt DateTime @default(now())

  @@unique([userId, chain])
  @@unique([chain, address])
}

/// Watcher cursors (last scanned block / signature per source).
model ScanCursor {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ZcashOrder {
  id         String   @id @default(cuid())
  txid       String   @unique
  memoRaw    Bytes
  marketId   String
  side       Side
  size       Decimal  @db.Decimal(36, 8)
  returnAddr String
  status     String
  createdAt  DateTime @default(now())
}

model Order {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  hlMarket   String
  side       Side
  size       Decimal  @db.Decimal(36, 8)
  price      Decimal  @db.Decimal(36, 8)
  hlOid      BigInt?
  builderFee Decimal? @db.Decimal(36, 8)
  status     String
  createdAt  DateTime @default(now())

  // Phase 4: HL execution. hlMarket = outcome id; side = outcome side bought/sold.
  isBuy      Boolean  @default(true)
  tif        String   @default("Ioc")
  filledSize Decimal  @default(0) @db.Decimal(36, 8)
  avgPx      Decimal? @db.Decimal(36, 8)
  /// true = paper fill against the live testnet book (owner-approved deviation); no oid/hash exists.
  simulated  Boolean  @default(false)
  execution  Json?
  updatedAt  DateTime @default(now()) @updatedAt

  // Phase 5: Flow A saga. `step` is the last completed step; each step's tx is persisted so a
  // retry with the same idempotencyKey resumes instead of repeating chain writes.
  idempotencyKey String?  @unique
  step           String   @default("created")
  stakeUsd       Decimal? @db.Decimal(18, 6)
  stakeSalt      String? // hex salt of the size commitment on the Position PDA
  tempoStakeTx   String?
  escrowTx       String? // final sig of confidential transfer user → escrow
  solanaOpenTx   String?
  error          String?
  parentId       String? // close orders point at the bet they unwind

  settlement Settlement?
  hedge      Hedge?

  @@index([userId])
}

model Settlement {
  orderId       String  @id
  order         Order   @relation(fields: [orderId], references: [id])
  outcome       String
  pnl           Decimal @db.Decimal(36, 8)
  solanaTx      String?
  tempoPayoutTx String?
  memoHash      String? @unique

  // Phase 5
  payoutUsd    Decimal  @default(0) @db.Decimal(18, 6)
  payoutSalt   String?
  escrowPayTx  String? // confidential transfer escrow → user (absent when payout is 0)
  closeOrderId String? // last close-at-mark Order (all closes: Order.parentId = this orderId)
  escrowTopUpTx String? // house-float top-up into escrow, when stakes didn't cover the payout
  createdAt    DateTime @default(now())
}

model Hedge {
  orderId        String  @id
  order          Order   @relation(fields: [orderId], references: [id])
  stockToken     String
  amountIn       Decimal @db.Decimal(36, 18)
  amountOut      Decimal @db.Decimal(36, 18)
  uniswapTx      String
  chainlinkRound String
}

model AgentSession {
  id             String  @id @default(cuid())
  ownerId        String
  owner          User    @relation(fields: [ownerId], references: [id])
  agentPubkey    String  @unique
  capUsd         Decimal @db.Decimal(18, 6)
  spentUsd       Decimal @default(0) @db.Decimal(18, 6)
  tempoSessionId String?
}

model Receipt {
  id          String     @id @default(cuid())
  kind        String
  payloadHash String     @unique
  proofRef    String?
  visibility  Visibility @default(private)
  createdAt   DateTime   @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// WebAuthn challenges (single use, short TTL).
model AuthChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  purpose   String // register | login
  createdAt DateTime @default(now())
}

/// Indexed TIP-20 TransferWithMemo events touching tyr addresses (PRD 2.6).
model TempoTransfer {
  id           String   @id @default(cuid())
  txHash       String
  logIndex     Int
  blockNumber  BigInt
  token        String
  from         String
  to           String
  amount       Decimal  @db.Decimal(36, 6)
  memo         String
  settlementId String?
  createdAt    DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([memo])
}

/// memo32 → settlement mapping written when a payout is sent (PRD 2.5).
model PayoutMemo {
  memo         String   @id
  settlementId String   @unique
  txHash       String?
  createdAt    DateTime @default(now())
}
