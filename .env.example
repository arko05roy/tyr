# tyr.bet — TESTNET ONLY. The API refuses to boot if any RPC below resolves to a mainnet.
# Copy to .env and fill. Public values + their source are recorded in docs/human-values.md.

# ── Infra (local: `pnpm db:up`) ─────────────────────────────────────────────
DATABASE_URL=postgresql://tyr:tyr@localhost:5432/tyr
REDIS_URL=redis://localhost:6379

# ── HUMAN STOP 0: RPC endpoints ─────────────────────────────────────────────
# tempo.xyz/developers → Moderato testnet network details
TEMPO_RPC_URL=
TEMPO_CHAIN_ID=
# helius.dev free devnet key, or https://api.devnet.solana.com (rate-limited)
SOLANA_RPC_URL=https://api.devnet.solana.com
# Zcash testnet lightwalletd, host:port (gRPC over TLS) — zechub.wiki / zcash docs
ZCASH_LIGHTWALLETD_URL=testnet.zec.rocks:443
# Local regtest indexer (infra/zcash-regtest, `docker compose up -d`) — used while no TAZ is available
ZCASH_LIGHTWALLETD_URL_REGTEST=http://127.0.0.1:9067
# Hyperliquid docs → testnet API
HL_API_URL=https://api.hyperliquid-testnet.xyz
# docs.robinhood.com/chain → testnet network page
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=
# Alchemy dashboard — one app per network
SEPOLIA_RPC=
BASE_SEPOLIA_RPC=
ARB_SEPOLIA_RPC=

# ── HUMAN STOP 1: funded testnet wallets (private — never commit) ───────────
# solana-keygen new → path to keypair JSON; fund via faucet.solana.com
SOLANA_TREASURY_KEYPAIR=
# cast wallet new; fund via Tempo Moderato faucet
TEMPO_SPONSOR_PRIVATE_KEY=
# Zingo/Ywallet testnet mode; fund via TAZ faucet
ZCASH_TESTNET_SEED=
ZCASH_USER_TESTNET_SEED=
# HL testnet: master wallet + approved agent (API) wallet; USDC via app.hyperliquid-testnet.xyz/drip
HL_MASTER_PRIVATE_KEY=
HL_AGENT_PRIVATE_KEY=
# Stop 4: builder = HL master address (owner decision); f in tenths of a bp (10 = 1bp)
TYR_BUILDER_ADDRESS=
TYR_BUILDER_FEE_TENTHS_BPS=10
# paper (owner-approved: fills against live testnet book) | live (needs testnet USDC in the float)
HL_EXECUTION=paper
# bearer token for /api/admin/* (openssl rand -hex 32)
TYR_ADMIN_TOKEN=
# Robinhood Chain testnet faucet (docs.robinhood.com/chain)
ROBINHOOD_HOT_WALLET_KEY=
# ── Phase 6: funding router (HUMAN STOP 6) ──────────────────────────────────
# HD seed for per-user EVM deposit EOAs (viem generateMnemonic); same address on every EVM testnet
EVM_DEPOSIT_MNEMONIC=
# test-only "user" wallets that send real testnet deposits in deposit.*.test.ts:
#   EVM: Circle USDC (faucet.circle.com) + gas ETH on Sepolia / Base Sepolia / Arb Sepolia, test ETH on RH
EVM_TEST_SENDER_KEY=
#   Solana devnet: Circle devnet USDC (faucet.circle.com) + a little SOL (solana-keygen new)
SOLANA_TEST_SENDER_KEYPAIR=keys/solana-test-sender.json
# funding worker tick
FUNDING_INTERVAL_MS=15000

# ── Phase 2: Tempo backend ──────────────────────────────────────────────────
# 32 random bytes hex (openssl rand -hex 32) — encrypts backend-held access keys
TYR_SECRETS_KEY=
# HUMAN STOP 2: WebAuthn relying party (localhost for dev, tyr.bet later)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Phase 3: Solana (HUMAN STOP 3) ──────────────────────────────────────────
# Program upgrade authority + tyr_settlement Config admin (solana-keygen new; ~5 devnet SOL)
SOLANA_DEPLOYER_KEYPAIR=keys/solana-deployer.json
# 32 random bytes hex — compliance auditor ElGamal key + attestation signer (auditor ENABLED)
SOLANA_AUDITOR_SEED=
# Output of `pnpm tsx scripts/solana-setup.ts` (tyrUSD Token-2022 confidential mint)
SOLANA_TYRUSD_MINT=

# Phase 7 — Zcash sidecars (services/zcash-sidecar) + FROST signers (infra/frost)
ZCASH_SIDECAR_URL=http://127.0.0.1:7200
ZCASH_USER_SIDECAR_URL=http://127.0.0.1:7201
# zebrad JSON-RPC on the local regtest (tests mine blocks through it)
ZCASH_REGTEST_RPC=http://127.0.0.1:18232
# optional override of the ZEC/USD source (Stop 7: CoinGecko simple price)
# ZEC_USD_URL=
FROST_MAX_PAYOUT_ZAT=1000000000
