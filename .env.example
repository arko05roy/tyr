# tyr.bet — TESTNET ONLY. The API refuses to boot if any RPC below resolves to a mainnet.
# Copy to .env and fill. Public values + their source are recorded in docs/human-values.md.

# ── Infra (local: `pnpm db:up`) ─────────────────────────────────────────────
DATABASE_URL=postgresql://tyr:tyr@localhost:5432/tyr
REDIS_URL=redis://localhost:6379

# ── HUMAN STOP 0: RPC endpoints ─────────────────────────────────────────────
# tempo.xyz/developers → Moderato testnet network details
TEMPO_RPC_URL=
TEMPO_CHAIN_ID=
# helius.dev free devnet key, or https://api.devnet.solana.com (rate-limited)
SOLANA_RPC_URL=https://api.devnet.solana.com
# Zcash testnet lightwalletd, host:port (gRPC over TLS) — zechub.wiki / zcash docs
ZCASH_LIGHTWALLETD_URL=
# Hyperliquid docs → testnet API
HL_API_URL=https://api.hyperliquid-testnet.xyz
# docs.robinhood.com/chain → testnet network page
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=
# Alchemy dashboard — one app per network
SEPOLIA_RPC=
BASE_SEPOLIA_RPC=
ARB_SEPOLIA_RPC=

# ── HUMAN STOP 1: funded testnet wallets (private — never commit) ───────────
# solana-keygen new → path to keypair JSON; fund via faucet.solana.com
SOLANA_TREASURY_KEYPAIR=
# cast wallet new; fund via Tempo Moderato faucet
TEMPO_SPONSOR_PRIVATE_KEY=
# Zingo/Ywallet testnet mode; fund via TAZ faucet
ZCASH_TESTNET_SEED=
ZCASH_USER_TESTNET_SEED=
# HL testnet: master wallet + approved agent (API) wallet; USDC via app.hyperliquid-testnet.xyz/drip
HL_MASTER_PRIVATE_KEY=
HL_AGENT_PRIVATE_KEY=
# Robinhood Chain testnet faucet (docs.robinhood.com/chain)
ROBINHOOD_HOT_WALLET_KEY=
# Sepolia / Base Sepolia / Arb Sepolia faucets
EVM_DEPOSIT_RECEIVER_KEY=
